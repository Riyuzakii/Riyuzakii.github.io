{{- /*
  Override of Hugo's built-in home-page RSS template.

  Why this exists: Hugo's internal RSS template (layouts/_default/rss.xml)
  ranges over ALL of the site's RegularPages, which includes standalone
  pages like content/about.md. That made "About" show up in the feed as
  if it were a new post. This override restricts the home RSS feed to
  pages in the "posts" section only. Do not delete this as "redundant"
  with the internal template — the internal template is what caused the bug.

  Everything else mirrors Hugo's default rss.xml structure (channel
  metadata, atom:link self-reference, services.rss limit handling) so the
  feed stays valid RSS 2.0 and behaves the same as before except for the
  page selection.
*/ -}}
{{- $pages := where .Site.RegularPages "Section" "posts" -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- /*
  This template renders through html/template (Hugo's default for
  overridden output-format templates), which contextually HTML-escapes
  pipeline output — e.g. "&" in a post title becomes "&amp;", which is
  required for the feed to stay well-formed XML. Do NOT disable that
  escaping (e.g. via outputFormats.RSS.isPlainText) to "fix" the XML
  declaration below — that was tried and it turns off escaping for
  EVERYTHING, including titles/descriptions, which silently corrupts the
  feed the moment a post title contains &, <, >, or ". Instead, mark only
  the literal XML declaration itself as safe so it's emitted verbatim.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne .Title .Site.Title }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ .Site.Title }}</description>
    <generator>Hugo -- gohugo.io</generator>{{ with .Site.Language.Locale }}
    <language>{{ . }}</language>{{ end }}{{ with .Site.Copyright }}
    <copyright>{{ . }}</copyright>{{ end }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- /*
        Not `.Summary | html`: the summary is rendered HTML, so it carries the
        margin-note scaffolding — <label class="margin-toggle">, the hidden
        <input type="checkbox"> and the note <span>. A feed reader has none of
        this site's CSS, so it draws a stray checkbox mid-sentence with the
        note text spliced into the prose: precisely the interruption the
        margin notes exist to avoid. plainify strips the markup; an explicit
        front-matter `description` wins if the post has one, matching what
        head.html already does for the meta description.
      */ -}}
      <description>{{ with .Description }}{{ . }}{{ else }}{{ .Summary | plainify | truncate 300 }}{{ end }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
